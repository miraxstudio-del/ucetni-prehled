# ============================================================
# Účetní přehled — příklad konfigurace prostředí
# Zkopíruj na .env a doplň hodnoty. Soubor .env NIKDY necommituj.
# ============================================================

APP_NAME="Účetní přehled"
# Lokální jednouživatelská aplikace
APP_ENV=local
# vygeneruj: php artisan key:generate (šifruje session, tokeny, DB casty)
APP_KEY=
# v produkci VŽDY false
APP_DEBUG=false
# start.bat nastaví konkrétní lokální port automaticky
APP_URL=http://localhost:8000

# Jazyk aplikace (struktura připravena na i18n)
APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

# Paralelní workery pro php artisan serve. POZOR: funguje jen na Linux/macOS
# (potřebuje fork), na Windows se ignoruje — tam server zůstává jednovláknový.
PHP_CLI_SERVER_WORKERS=4

# Hashování hesel — Argon2id (bezpečnostní požadavek, neměnit)
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# v produkci: error
LOG_LEVEL=error

# ---------- Databáze ----------
# start.bat používá SQLite v data/ucetni-prehled.sqlite.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# ---------- Session (bezpečnostní požadavky) ----------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie se neposílá u požadavků, které začaly na cizím webu
SESSION_SAME_SITE=strict
SESSION_DOMAIN=null
# v produkci true (pouze HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Lokálně sync (e-maily hned do logu, bez workeru).
# Produkce: database + scheduler spouští queue:work každou minutu.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------- E-mail ----------
# Lokálně: log (maily končí v storage/logs/laravel.log)
# Produkce: SMTP hostingu (dle administrace HostCreators)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="admin@miraxstudio.cz"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Integrace ----------
# ARES REST API (veřejné, bez klíče)
ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest

# Fio banka — tokeny se ukládají šifrovaně per organizace v DB,
# tady jen base URL API
FIO_API_BASE_URL=https://fioapi.fio.cz/v1/rest

# Lokální režim nevolá HIBP; aplikace neobsahuje přihlašování.
HIBP_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
